# Copy to .env and fill in.

# Provided MCP server needs a Tavily key (≈1000 free searches/mo); without it
# the server falls back to DuckDuckGo and you'll hit rate limits fast.
TAVILY_API_KEY=

# Gateway V3 (provided) — where it listens. Default matches class.
GATEWAY_URL=http://localhost:8101

# How to launch the PROVIDED MCP server over stdio. Adjust to your layout.
MCP_SERVER_CMD=uv run python mcp_server.py

# ── Strong model (Claude / GPT) via the gateway ─────────────────────────────
# The gateway (providers.py) now has native `openai` + `anthropic` providers.
# Put YOUR key in the GATEWAY's .env (~/Downloads/agentic/.env), then set the
# one knob below so every agent LLM call uses it.
#   GPT:    OPENAI_API_KEY + (optional) OPENAI_MODEL=gpt-4o
#   Claude: ANTHROPIC_API_KEY + (optional) ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# AGENT_PROVIDER overrides per-call routing for the whole agent:
#   "openai" | "anthropic" | "g" (gemini) | unset = default (gemini + auto_route)
AGENT_PROVIDER=openai

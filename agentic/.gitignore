# runtime state — excluded by .gitignore per the assignment submission rubric.
# Cleanable between attempts with `rm -rf state`.
state/
usage.json

# secrets
.env

# python
__pycache__/
*.pyc
.venv/
.uv/

# Sandbox is runtime-mutable, but our test corpus (papers/) IS part of the
# submission. Keep papers/, ignore everything else under sandbox/.
sandbox/*
!sandbox/papers/

# Provided gateway code only (their versions); our mcp_server.py + our
# S7 tools (index_document, search_knowledge) are tracked.
llm_gatewayV3/
llm_gatewayV2/
llm_gatewayV7/

# Copy to .env and fill in. .env is gitignored.

# Gemini API key — https://aistudio.google.com/apikey (free tier: 15 RPM / 500 RPD)
GEMINI_API_KEY=

# Default model; override only if you need a larger / pro tier.
GEMINI_MODEL=gemini-2.5-flash-lite

# Sleep before every LLM call to stay under the free-tier rate limit.
# Bump to 8 if you see HTTP 429s; set to 0 when testing with a stub.
THROTTLE_SECONDS=4

# ─── Tool behavior ────────────────────────────────────────────────────────

# Max results per web_search call. 5 is a sane default.
SEARCH_MAX_RESULTS=5

# Max characters fetch_page returns per URL. Keeps LLM context tight.
FETCH_MAX_CHARS=5000

# Where save_answer writes markdown files. Defaults to ./answers/.
ANSWERS_DIR=

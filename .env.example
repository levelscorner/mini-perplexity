# Copy to .env and fill in what you use. .env is gitignored.

# ─── Backend selection ────────────────────────────────────────────────────
# LLM_PROVIDER options:
#   auto    (default) try Ollama first; if server is unreachable, use Gemini
#   ollama  force local Ollama; fails loudly if `ollama serve` isn't running
#   gemini  force cloud Gemini; requires GEMINI_API_KEY below
LLM_PROVIDER=auto

# ─── Ollama (local, no key needed, no throttle) ───────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# ─── Gemini (cloud fallback) ──────────────────────────────────────────────
# Only needed when LLM_PROVIDER=gemini or auto-fallback kicks in.
# Free tier: 15 RPM / 500 RPD. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
THROTTLE_SECONDS=4

# ─── Tool behavior ────────────────────────────────────────────────────────
# Max results per web_search call. 5 is a sane default.
SEARCH_MAX_RESULTS=5

# Max characters fetch_page returns per URL. Keeps LLM context tight.
FETCH_MAX_CHARS=5000

# Where save_answer writes markdown files. Defaults to ./answers/.
ANSWERS_DIR=
